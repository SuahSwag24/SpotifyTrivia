@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Spotify Trivia</h1>

    @if (ViewBag.IsLoggedIn == true)
    {
        <div class="alert alert-success mt-4">
            <p>✅ Logged in to Spotify!</p>
            <small>Token preview: <code>@ViewBag.TokenPreview</code></small>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-3">
            <a href="/playlists" class="btn btn-primary btn-lg">🎧 Single Player</a>
            <a href="/multiplayer" class="btn btn-outline-light btn-lg">👥 Multiplayer</a>
        </div>
    }
    else
    {
        <p class="lead">Connect your Spotify account to generate trivia quizzes from your playlists!</p>
        <a href="/login" class="btn btn-success btn-lg mt-3">Login with Spotify</a>
    }
</div>