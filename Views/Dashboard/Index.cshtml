@model SpotifyTrivia.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    /* Gradient banner transitioning from Spotify Navy blue to deep dark */
    .dashboard-hero {
        background: linear-gradient(180deg, #1e3264 0%, #121212 100%);
        border-radius: 16px;
        padding: 2.5rem 2rem;
    }

    /* Circular profile avatar with Spotify Green border */
    .avatar-img {
        width: 110px;
        height: 110px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #1DB954;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    }

    /* Elevated dark cards for stats and actions */
    .stat-card, .quick-action-card {
        background-color: #181818;
        border: 1px solid #282828;
        border-radius: 12px;
    }

    /* Hover lift animation on interactive cards */
    .quick-action-card:hover {
        transform: translateY(-4px);
        border-color: #1DB954;
    }
</style>

<div class="dashboard-hero mb-4 d-flex flex-column flex-md-row align-items-center gap-4 text-center text-md-start">
    <!-- User Avatar -->
    <img src="@Model.UserProfile.ProfileImageUrl" alt="Profile" class="avatar-img" />
    
    <div>
        <!-- Spotify Premium/Free Badge -->
        <span class="badge badge-spotify px-3 py-1 mb-2">@Model.UserProfile.Product Account</span>
        
        <!-- Welcome Heading -->
        <h1 class="display-5 fw-bold text-white mb-1">Welcome back, @Model.UserProfile.DisplayName! 👋</h1>
        <p class="text-secondary mb-0">Ready to test your music knowledge today?</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Column 1: Games Played -->
    <div class="col-12 col-md-4">
        <div class="stat-card p-3 text-center">
            <div class="text-secondary small fw-bold text-uppercase mb-1">Games Played</div>
            <div class="display-6 fw-bold text-white">@Model.GamesPlayed</div>
        </div>
    </div>

    <!-- Column 2: Playlists Available -->
    <div class="col-12 col-md-4">
        <div class="stat-card p-3 text-center">
            <div class="text-secondary small fw-bold text-uppercase mb-1">Playlists Available</div>
            <div class="display-6 fw-bold text-info">@Model.TopPlaylists.Count</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Card: Start Game CTA -->
    <div class="col-12 col-md-7">
        <div class="quick-action-card p-4 h-100 d-flex flex-column justify-content-between shadow-lg">
            <div>
                <h3 class="fw-bold text-white mb-2">Start a New Trivia Game 🎧</h3>
                <p class="text-secondary">Choose from your saved Spotify playlists and test how well you know your favorite tracks.</p>
            </div>
            <div class="mt-3">
                <a href="/playlists" class="btn btn-success btn-lg fw-bold rounded-pill px-4">
                    Browse All Playlists ➡️
                </a>
            </div>
        </div>
    </div>

    <!-- Right Card: Spotify Sync Status -->
    <div class="col-12 col-md-5">
        <div class="quick-action-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <h4 class="fw-bold text-white mb-3">Spotify Sync Status</h4>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary">
                    <span class="text-secondary">Connected User</span>
                    <span class="fw-bold text-white">@Model.UserProfile.DisplayName</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span class="text-secondary">Spotify Profile</span>
                    <a href="@Model.UserProfile.SpotifyUrl" target="_blank" class="text-success text-decoration-none fw-bold">Open Spotify ↗</a>
                </div>
            </div>
            <div class="mt-3">
                <a href="/auth/login" class="btn btn-outline-secondary w-100 rounded-pill">
                    Re-authenticate Account
                </a>
            </div>
        </div>
    </div>
</div>