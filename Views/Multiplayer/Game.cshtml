@using SpotifyTrivia.Models.Multiplayer
@model LobbyModel
@{
    ViewData["Title"] = "Game";
}

<script src="~/js/search-answer.js" asp-append-version="true"></script>
<script src="/js/multiplayer-hub.js"></script>
<script src="/js/game.js"></script>
<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />

<div class="game-wrapper game-container" data-lobby-code="@Model.Code" data-player-id="@ViewBag.PlayerId" data-display-name="@ViewBag.DisplayName" data-is-host="@ViewBag.IsHost.ToString().ToLower()">

    <div class="text-end mb-2">
        <button id="leave-game-btn" type="button" class="btn btn-sm btn-danger">Leave Game</button>
    </div>

    <!-- Phase 1: Countdown -->
    <div id="countdown-phase" class="phase-panel text-center">
        <h2 class="text-secondary uppercase fs-6 fw-bold tracking-widest">Get Ready</h2>
        <span class="text-secondary fs-3" id="prompt-text"></span>
        <div id="audio-loading-container" class="d-flex justify-content-center my-4">
            <div id="audio-loading-spinner" class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading audio</span>
            </div>
        </div>
        <div id="countdown-number" style="display:none;"></div>
    </div>

    <!-- Phase 2: Question -->
    <div id="question-phase" class="phase-panel" style="display:none;">
        <div class="question-layout">
            <!-- Left Column: Playing Field -->
            <div class="question-main text-center">
                <div class="progress-container">    
                    <div>
                        <span id="round-counter" class="round-counter-badge"></span>
                    </div>
                    <div class="progress-track">
                        <div id="progress-fill" class="progress-fill"></div>
                    </div>
                    <div id="stem-progress" class="stem-progress d-none">
                        <div class="stem-progress-heading">
                            <span>Stem layers</span>
                            <span id="stem-progress-current" class="stem-progress-current" aria-live="polite">Waiting for first layer</span>
                        </div>
                        <div id="stem-progress-segments" class="stem-progress-segments" role="progressbar" aria-label="Stem layers revealed" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-valuetext="No layers revealed"></div>
                    </div>
                </div>

                <div id="album-cover-wrapper" class="album-frame-wrapper">
                    <img id="album-cover" class="album-frame" src="" alt="Album Artwork" />
                    <div id="album-cover-hidden-placeholder" class="album-hidden-placeholder">
                        <div class="equalizer-bars">
                            <span class="bar"></span>
                            <span class="bar"></span>
                            <span class="bar"></span>
                            <span class="bar"></span>
                            <span class="bar"></span>
                        </div>
                        <span class="hidden-icon">🚫</span>
                        <p class="hidden-text">Album hidden</p>
                    </div>
                </div>

                <audio id="round-audio"></audio>
                <audio id="next-round-audio" preload="auto"></audio>
                
                <div>
                    <span id="round-timer" class="timer-badge">20</span>
                </div>
                <button id="enable-audio-btn" type="button" class="btn btn-outline-light btn-sm d-none mb-3">Enable audio</button>

                <div id="answer-choices">
                    <!-- 4 dynamic buttons built by JS per question -->
                </div>

                <div id="search-answer" class="search-answer d-none">
                    <fieldset id="search-answer-fields" class="search-answer-fields">
                        <div id="search-answer-tabs" class="search-answer-tabs">
                            <button type="button" class="search-tab active" data-kind="track">Song</button>
                            <button type="button" class="search-tab" data-kind="artist">Artist</button>
                        </div>
                        <input id="search-answer-input" type="search" class="form-control"
                            autocomplete="off" autocapitalize="off" spellcheck="false" />
                        <div id="search-answer-artist-bar" class="search-artist-bar d-none">
                            <span id="search-answer-artist-label"></span>
                            <button type="button" id="search-answer-artist-submit" class="btn btn-spotify btn-sm">Answer with artist only</button>
                            <button type="button" id="search-answer-artist-back" class="btn btn-outline-custom btn-sm">Back</button>
                        </div>
                        <ul id="search-answer-results" class="search-answer-results"></ul>
                    </fieldset>
                    <div id="search-answer-status" class="search-answer-status" aria-live="polite"></div>
                </div>
            </div>

            <!-- Right Column: Player Status Panel -->
            <div class="side-player-panel">
                <h6 class="text-secondary fw-bold text-uppercase mb-2" style="font-size:0.75rem;">Players</h6>
                <ul id="side-player-list" class="side-player-list">
                    @foreach (var player in Model.Players.Values)
                    {
                        <li class="player-pill-item" data-player-id="@player.PlayerId">
                            <span class="player-dot status-@(player.Status.ToString().ToLower())"></span>
                            <span class="player-name">@player.DisplayName</span>
                            <span class="player-status-text">@(player.Status == PlayerStatus.Locked ? "Locked" : player.Status.ToString().ToLower())</span>
                            @if (ViewBag.IsHost == true && player.PlayerId != ViewBag.PlayerId)
                            {
                                <button type="button"
                                        class="kick-player-btn"
                                        data-target-player="@player.PlayerId"
                                        data-target-name="@player.DisplayName"
                                        title="Remove @player.DisplayName from the game"
                                        aria-label="Remove @player.DisplayName from the game">
                                    <span aria-hidden="true">&#x22EE;</span>
                                </button>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>


    <!-- Phase 3: Reveal -->
    <div id="reveal-phase" class="phase-panel text-center" style="display:none;">
        <h3 class="h4 fw-bold text-white mb-3">Round Summary</h3>

        <img src="" alt="Album Artwork" id="reveal-album-cover" class="album-frame reveal-album-cover">

        <p id="correct-answer-label" class="fs-5 text-success fw-bold mb-4"></p>
        <ul id="reveal-scoreboard" class="scoreboard-list"></ul>
    </div>

    <!-- Phase 4: Finished -->
    <div id="finished-phase" class="phase-panel text-center" style="display:none;">
        <h2 class="display-6 fw-bold text-white mb-4">🏆 Final Results</h2>
        <ol id="final-leaderboard" class="scoreboard-list"></ol>

        <h3 class="h5 fw-bold text-white mt-4 mb-3">Song Recap</h3>
        <ul id="song-list-board" class="scoreboard-list text-start"></ul>

        <div class = "mt-4 d-flex justify-content-center gap-2">
            <button id="continue-game-btn" type="button" class="btn btn-primary mt-4" style="display:none;">Continue Playing</button>
            <button id="return-to-lobby-btn" type="button" class="btn btn-warning mt-4" style="display:none;">Return to Lobby</button>
        </div>
    </div>

    <!-- Error Banner -->
    <div id="game-error" class="alert alert-danger mt-3 rounded-3" style="display:none; background-color: rgba(226, 33, 52, 0.15); border-color: rgba(226, 33, 52, 0.4); color: #f15e6c;"></div>

    <!-- Toast Container -->
    <div id="toast-stack" style="position: fixed; bottom: 20px; right: 20px; display: flex; flex-direction: column' gap: 0.5rem; z-index: 1050;"></div>
</div>

<div id="volume-control" class="volume-control">
    <span id="volume-icon">🔊</span>
    <input type="range" id="volume-slider" class="custom-range-spotify volume-slider-compact" min="0" max="100" value="30" />
</div>

<div class="modal fade" id="leave-confirmation-modal" tabindex="-1"
     aria-labelledby="leave-confirmation-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content leave-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="leave-confirmation-title">Leave game?</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p id="leave-confirmation-message" class="mb-0">
                    Are you sure you want to leave?
                </p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-light"
                        data-bs-dismiss="modal">
                    Stay
                </button>
                <button type="button" id="confirm-leave-btn"
                        class="btn btn-danger">
                    Leave Game
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="kick-confirmation-modal" tabindex="-1"
     aria-labelledby="kick-confirmation-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content leave-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="kick-confirmation-title">Remove player?</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p id="kick-confirmation-message" class="mb-0">
                    Remove this player from the game?
                </p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" id="confirm-kick-btn" class="btn btn-danger">
                    Remove Player
                </button>
            </div>
        </div>
    </div>
</div>